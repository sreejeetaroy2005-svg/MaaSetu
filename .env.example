# Copy to .env.local for local development against the emulators.
# For a hosted/production build, fill in the real Firebase values and
# leave VITE_USE_EMULATORS unset (or set to 'false').

# --- Hosted / Production (real Firebase project) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=maasetu-demo
VITE_FIREBASE_APP_ID=

# --- Local emulator dev only ---
# VITE_USE_EMULATORS=true

# Demo UI mode (shows demo phone numbers, demo tools menu, and load demo data button)
VITE_DEMO_MODE=true

# OTP shown to users in emulator/demo mode (Auth emulator accepts any 6-digit code)
VITE_DEMO_OTP=123456
